rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isValidTimestamp(val) {
      return val is timestamp && val <= request.time;
    }

    function isValidUserProfile(data) {
      return data.size() == 5
        && data.userId is string && data.userId == request.auth.uid
        && data.displayName is string && data.displayName.size() > 0 && data.displayName.size() <= 100
        && data.unlockedLevel is int && data.unlockedLevel >= 1 && data.unlockedLevel <= 30
        && data.totalStars is int && data.totalStars >= 0 && data.totalStars <= 90
        && isValidTimestamp(data.updatedAt);
    }

    function isValidLevelRecord(data) {
      return data.size() == 6
        && data.userId is string && data.userId == request.auth.uid
        && data.levelNumber is int && data.levelNumber >= 1 && data.levelNumber <= 30
        && data.stars is int && data.stars >= 1 && data.stars <= 3
        && data.bestMoves is int && data.bestMoves >= 1 && data.bestMoves <= 9999
        && data.bestTimeSeconds is int && data.bestTimeSeconds >= 1 && data.bestTimeSeconds <= 86400
        && isValidTimestamp(data.completedAt);
    }

    match /users/{userId} {
      allow get: if isOwner(userId);
      allow list: if false;
      allow create: if isOwner(userId) && isValidUserProfile(request.resource.data);
      allow update: if isOwner(userId) && isValidUserProfile(request.resource.data);
      allow delete: if false;

      match /records/{levelNumber} {
        allow get, list: if isOwner(userId);
        allow create: if isOwner(userId) && isValidLevelRecord(request.resource.data);
        allow update: if isOwner(userId) && isValidLevelRecord(request.resource.data);
        allow delete: if false;
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
